						"method": "POST",
						"header": [
							{
								"key": "X-From-The-Hart-Authorization",
								"value": "Bearer {{jwt_token}}",
								"type": "text",
								"description": "JWT token for authentication"
							},
							{
								"key": "Content-Type",
								"value": "application/json",
								"type": "text"
