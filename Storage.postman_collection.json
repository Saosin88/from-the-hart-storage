		"_postman_id": "a1b2c3d4-e5f6-4a5b-8c9d-0e1f2a3b4c5d",
		"name": "From The Hart - Storage API",
		"description": "Secure cloud storage API for From The Hart platform.\n\n## Features\n- Health monitoring and status checks\n- CloudFront signed URLs for secure file access\n- File and folder listing with metadata\n- Folder creation and management\n- RESTful API design\n- Comprehensive error handling\n\n## Authentication\nMost endpoints require a valid JWT token in the X-From-The-Hart-Authorization header.\n\n## Environment Variables\n- `base_url`: Base URL for the Storage API (e.g., https://your-lambda-url.execute-api.af-south-1.amazonaws.com)\n- `jwt_token`: Valid JWT token for authenticated requests\n- `user_id`: User ID for testing user-specific endpoints",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "Health & Documentation",
			"item": [
				{
					"name": "Health Check",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test(\"Response has data object\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData).to.have.property('data');",
									"    pm.expect(jsonData.data).to.have.property('status');",
									"    pm.expect(jsonData.data).to.have.property('uptime');",
									"    pm.expect(jsonData.data).to.have.property('timestamp');",
									"});",
									"",
									"pm.test(\"Status is ok\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.data.status).to.eql('ok');",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/storage/health",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"storage",
								"health"
							]
						},
						"description": "Check the health status of the Storage API.\n\nReturns:\n- `status`: Service status (always \"ok\" when responding)\n- `uptime`: Service uptime in seconds\n- `timestamp`: Current timestamp in milliseconds since UNIX epoch\n\nThis endpoint does not require authentication."
					},
					"response": [
						{
							"name": "Success",
							"originalRequest": {
								"method": "GET",
								"header": [],
								"url": {
									"raw": "{{base_url}}/storage/health",
									"host": [
										"{{base_url}}"
									],
									"path": [
										"storage",
										"health"
									]
								}
							},
							"status": "OK",
							"code": 200,
							"_postman_previewlanguage": "json",
							"header": [
								{
									"key": "Content-Type",
									"value": "application/json"
								}
							],
							"cookie": [],
							"body": "{\n    \"data\": {\n        \"status\": \"ok\",\n        \"uptime\": 12345,\n        \"timestamp\": 1700000000000\n    }\n}"
						}
					]
